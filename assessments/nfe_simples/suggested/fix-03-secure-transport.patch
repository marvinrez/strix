 README.md                      |  2 +
 src/nfe/config.py              | 10 ++++
 src/nfe/models.py              | 41 +++++++++++++-
 tests/test_secure_transport.py | 98 ++++++++++++++++++++++++++++++++++
 4 files changed, 150 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_secure_transport.py

diff --git a/README.md b/README.md
index fbc4647..23e3fa2 100644
--- a/README.md
+++ b/README.md
@@ -28,6 +28,8 @@ pip install -e ".[dev]"
 3. Ajuste os dados da nota e o caminho do certificado em `params.json`.
    - Se receber `495 SSL Certificate Error`, informe tambem `certificate.chain_path` com o bundle PEM da cadeia intermediaria do seu certificado cliente.
    - Se `chain_path` nao for informado, o sistema tenta gerar automaticamente um arquivo `*.chain.pem` ao lado do `.pfx` usando os links de cadeia da AC no proprio certificado.
+   - Se o erro persistir, aponte `request.verify_tls` para o arquivo do bundle PEM das CAs que devem ser aceitas no lado do servidor. `request.verify_tls: false` desativa a verificacao e nao e aceito quando `environment` e `producao`.
+   - `request.api_base_url_override`, quando informado, precisa usar `https://`.
    - No bloco `dps`, se `issue_date`, `competence_date` e `issue_datetime` estiverem em branco (`""`), o sistema preenche automaticamente com data/hora atual.
    - Quando `competence_date` estiver em branco, ela assume o mesmo valor de `issue_date`.
    - Para rotina mensal, normalmente voce so precisa alterar `dps.number`.
diff --git a/src/nfe/config.py b/src/nfe/config.py
index 5e6636c..5eed173 100644
--- a/src/nfe/config.py
+++ b/src/nfe/config.py
@@ -162,4 +162,14 @@ def load_params(path: str | Path) -> NfseParams:
         if generated_chain is not None:
             params.certificate.chain_path = str(generated_chain.resolve())
 
+    if isinstance(params.request.verify_tls, str):
+        bundle_path = Path(params.request.verify_tls)
+        if not bundle_path.is_absolute():
+            bundle_path = (params_path.parent / bundle_path).resolve()
+        if not bundle_path.exists():
+            raise ConfigError(
+                f"Bundle de CA de request.verify_tls nao encontrado: {bundle_path}"
+            )
+        params.request.verify_tls = str(bundle_path)
+
     return params
diff --git a/src/nfe/models.py b/src/nfe/models.py
index 8eb3f7f..0055274 100644
--- a/src/nfe/models.py
+++ b/src/nfe/models.py
@@ -1,8 +1,10 @@
 from __future__ import annotations
 
+import warnings
 from datetime import date, datetime
 from decimal import Decimal
 from typing import Literal
+from urllib.parse import urlparse
 
 from pydantic import BaseModel, Field, field_validator, model_validator
 
@@ -22,9 +24,30 @@ class CertificateConfig(BaseModel):
 class RequestConfig(BaseModel):
     timeout_seconds: int = Field(default=30, ge=1, le=180)
     retries: int = Field(default=1, ge=0, le=5)
-    verify_tls: bool = True
+    verify_tls: bool | str = Field(
+        default=True,
+        description=(
+            "True para usar as CAs do sistema, ou caminho de um bundle PEM de CA. "
+            "False desativa a verificacao e nao e aceito em producao."
+        ),
+    )
     api_base_url_override: str | None = None
 
+    @field_validator("api_base_url_override")
+    @classmethod
+    def validate_api_base_url(cls, value: str | None) -> str | None:
+        if value is None:
+            return None
+        parsed = urlparse(value)
+        if parsed.scheme != "https":
+            raise ValueError(
+                "request.api_base_url_override deve usar https:// - a DPS assinada, "
+                "com CNPJ e dados do tomador, trafega nesse canal"
+            )
+        if not parsed.netloc:
+            raise ValueError("request.api_base_url_override precisa incluir o host")
+        return value
+
 
 class Issuer(BaseModel):
     tax_id: str = Field(..., description="CPF ou CNPJ do prestador")
@@ -155,3 +178,19 @@ class NfseParams(BaseModel):
     service_taker: ServiceTaker
     service: ServiceData
     request: RequestConfig = Field(default_factory=RequestConfig)
+
+    @model_validator(mode="after")
+    def enforce_secure_transport(self) -> "NfseParams":
+        if self.request.verify_tls is False:
+            if self.environment == "producao":
+                raise ValueError(
+                    "request.verify_tls: false nao e aceito em producao. Se o erro for "
+                    "495 SSL Certificate Error, aponte request.verify_tls para o arquivo "
+                    "do bundle de CA em vez de desativar a verificacao"
+                )
+            warnings.warn(
+                "request.verify_tls: false - a identidade do servidor nao sera "
+                "verificada nesta execucao",
+                stacklevel=2,
+            )
+        return self
diff --git a/tests/test_secure_transport.py b/tests/test_secure_transport.py
new file mode 100644
index 0000000..d5ec310
--- /dev/null
+++ b/tests/test_secure_transport.py
@@ -0,0 +1,98 @@
+import json
+
+import pytest
+from pydantic import ValidationError
+
+from nfe.api_client import NfseApiClient
+from nfe.config import ConfigError, load_params
+from nfe.models import NfseParams, RequestConfig
+
+
+def _params(**overrides):
+    base = {
+        "environment": "producao",
+        "certificate": {"path": "./certificado.pfx", "password": "123"},
+        "issuer": {"tax_id": "12345678000199", "name": "Prestador"},
+        "service_taker": {
+            "tax_id": None,
+            "name": "Tomador Estrangeiro",
+            "is_foreign": True,
+            "country_code": "US",
+            "city": "San Francisco",
+            "street": "Market Street",
+            "number": "2261",
+        },
+        "service": {"description": "Servico", "amount": "10.00"},
+        "dps": {
+            "municipality_code": "3550308",
+            "series": "70000",
+            "number": "1",
+            "issue_date": "2026-05-24",
+            "competence_date": "2026-05-24",
+        },
+        "request": {},
+    }
+    base.update(overrides)
+    return base
+
+
+def test_rejects_http_base_url_override():
+    with pytest.raises(ValidationError, match="https://"):
+        RequestConfig(api_base_url_override="http://api-qualquer.example/SefinNacional")
+
+
+def test_rejects_base_url_override_without_host():
+    with pytest.raises(ValidationError, match="host"):
+        RequestConfig(api_base_url_override="https:///SefinNacional")
+
+
+def test_accepts_https_base_url_override():
+    config = RequestConfig(api_base_url_override="https://sefin.nfse.gov.br/SefinNacional")
+    assert config.api_base_url_override == "https://sefin.nfse.gov.br/SefinNacional"
+
+
+def test_rejects_disabled_tls_in_production():
+    with pytest.raises(ValidationError, match="producao"):
+        NfseParams.model_validate(_params(request={"verify_tls": False}))
+
+
+def test_warns_on_disabled_tls_outside_production():
+    params = _params(environment="producao_restrita", request={"verify_tls": False})
+    with pytest.warns(UserWarning, match="verify_tls"):
+        loaded = NfseParams.model_validate(params)
+    assert loaded.request.verify_tls is False
+
+
+def test_accepts_ca_bundle_path_in_production():
+    loaded = NfseParams.model_validate(_params(request={"verify_tls": "./ca-bundle.pem"}))
+    assert loaded.request.verify_tls == "./ca-bundle.pem"
+
+
+def test_ca_bundle_path_is_resolved_relative_to_params(tmp_path):
+    (tmp_path / "certificado.pfx").write_bytes(b"fake-pfx")
+    bundle = tmp_path / "ca-bundle.pem"
+    bundle.write_bytes(b"-----BEGIN CERTIFICATE-----\n")
+
+    params_path = tmp_path / "params.json"
+    params_path.write_text(
+        json.dumps(_params(request={"verify_tls": "./ca-bundle.pem"})), encoding="utf-8"
+    )
+
+    loaded = load_params(params_path)
+    assert loaded.request.verify_tls == str(bundle.resolve())
+
+
+def test_missing_ca_bundle_is_reported(tmp_path):
+    (tmp_path / "certificado.pfx").write_bytes(b"fake-pfx")
+    params_path = tmp_path / "params.json"
+    params_path.write_text(
+        json.dumps(_params(request={"verify_tls": "./nao-existe.pem"})), encoding="utf-8"
+    )
+
+    with pytest.raises(ConfigError, match="Bundle de CA"):
+        load_params(params_path)
+
+
+def test_client_passes_ca_bundle_to_requests():
+    loaded = NfseParams.model_validate(_params(request={"verify_tls": "/etc/ssl/ca.pem"}))
+    assert NfseApiClient(loaded).verify_tls == "/etc/ssl/ca.pem"
